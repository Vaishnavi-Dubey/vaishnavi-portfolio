# GitHub API — increases rate limit and unlocks pinned-repo GraphQL.
# Create at https://github.com/settings/tokens (no scopes required for public data).
GITHUB_TOKEN=

# Resend (https://resend.com) — used by /api/contact to deliver the form.
RESEND_API_KEY=
# Optional: override the From / To addresses used by /api/contact.
# Defaults: From "Portfolio <onboarding@resend.dev>", To vaishnavidubey1290@gmail.com
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Anthropic (used by the optional ChatWidget).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
